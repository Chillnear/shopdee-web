# Public Supabase client used to merge approved affiliate products into the catalog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials used by ingestion APIs and review actions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protect /admin/ingestion and the ingestion management APIs.
INGEST_ADMIN_TOKEN=

# Vercel Cron authorization for /api/cron/ingest.
CRON_SECRET=

# Configure the exact key names in each source record from official feeds.
# Example source feed_env_key: SHOPEE_OFFICIAL_FEED_URL
# Example source auth_env_key: SHOPEE_OFFICIAL_FEED_TOKEN
SHOPEE_OFFICIAL_FEED_URL=
SHOPEE_OFFICIAL_FEED_TOKEN=
